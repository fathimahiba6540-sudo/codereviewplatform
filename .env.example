# App Settings
PROJECT_NAME="AI Code Review Platform"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codereviewdb
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codereviewdb

# Security & Authentication
SECRET_KEY=change_this_to_a_super_secret_random_string_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=115200  # 8 days

# AI & LLM Provider Settings
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Vector DB Settings
VECTOR_DB_TYPE=chromadb
VECTOR_DB_PATH=./vector_db

# File Storage Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
